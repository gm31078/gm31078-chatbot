# Vercel Environment Variables (এগুলো Vercel ড্যাশবোর্ডে Settings → Environment Variables-এ যোগ করবেন)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# নোট: ওলামা (Ollama) লোকাল সার্ভার চায়, তাই Vercel সার্ভারলেসে ওলামা মডেল কাজ করবে না।
# অনলাইন ডিপ্লয়মেন্টের জন্য ওপেনএআই/ক্লড/গ্রক/ওপেনরাউটারের যেকোনো একটি API কী ব্যবহার করুন।
